# Example file showing a basic pygame "game loop"
import pygame
import random

# pygame setup
pygame.init()
screen = pygame.display.set_mode((1280, 720))
clock = pygame.time.Clock()
running = True

gameState = "titleScreen"

waitTime = round(random.uniform(1, 10), 3)
reactTriggered = False
elapsed_time = 0.0
reactionTime = 0.0


startButtonBox = pygame.Rect(390, 400, 500, 200)
reactionTimeTestBox = pygame.Rect(390, 400, 500, 200)

while running:
    # poll for events
    # pygame.QUIT event means the user clicked X to close your window
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if gameState == "titleScreen":
                if startButtonBox.collidepoint(event.pos):
                    gameState = "menu"
            if gameState == "menu":
                if reactionTimeTestBox.collidepoint(event.pos):
                    gameState = "reactionTimeTest"

    if gameState == "titleScreen":

        screen.fill("#7DDCFF")
        pygame.draw.rect(screen, "#FFFFFF", (140, 100, 1000, 150)) # Title Box

        pygame.draw.rect(screen, "#FFFFFF", (390, 400, 500, 200)) # Start Button Box

    if gameState == "menu":
        screen.fill("#7DDCFF")
        pygame.draw.rect(screen, "#FFFFFF", (390, 400, 500, 200)) # First Choice

    if gameState == "reactionTimeTest":
        screen.fill("#FF3636")


        dt = clock.tick(60) / 1000.0

        if not reactTriggered:
            elapsed_time += dt
            if elapsed_time >= waitTime:
                reactTriggered = True
                #print("green")
                
        if reactTriggered == True:
            screen.fill("#46ff4c")
            reactionTime += (1 / 60)

        pygame.draw.circle(screen, "#F0F0F0", (640, 360), 10)


        keys = pygame.key.get_pressed()
        if keys[pygame.K_w]:

            reactTriggered = False
            
            print(round(reactionTime, 3))

            gameState = "results"

            #print("W key pressed")
        

    # fill the screen with a color to wipe away anything from last frame

    # RENDER YOUR GAME HERE
    

    # flip() the display to put your work on screen
    pygame.display.flip()

    clock.tick(60)  # limits FPS to 60

pygame.quit()
